<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS LaunchAgent: starts the Universe IO server at login and restarts it if it stops.
     Filled in and installed by deploy/install_mac_service.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fun.universe-io.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/run_prod.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GALAXY_PYTHON</key>
    <string>__PYTHON__</string>
    <key>GALAXY_ALLOWED_ORIGINS</key>
    <string>__ORIGINS__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__LOGS__/server.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/server.log</string>
</dict>
</plist>
